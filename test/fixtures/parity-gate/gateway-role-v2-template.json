{
 "Description": "Apiable gateway-management role - one-click provisioning",
 "Parameters": {
  "ApiableTrustAccount": {
   "Type": "String",
   "Default": "034444869755",
   "AllowedPattern": "^[0-9]{12}$",
   "ConstraintDescription": "must be exactly one 12-digit AWS account id",
   "Description": "AWS account authorised to assume the Apiable gateway-management role",
   "MaxLength": 12,
   "MinLength": 12
  },
  "ApiableEgressCidr": {
   "Type": "String",
   "Default": "63.180.116.108/32",
   "AllowedPattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[1-2][0-9]|3[0-2])$",
   "ConstraintDescription": "must be an IPv4 CIDR block, for example 203.0.113.4/32",
   "Description": "CIDR Apiable calls from; the role refuses every request originating outside it"
  }
 },
 "Resources": {
  "GatewayRoleGatewayManagementRoleACBD3808": {
   "Type": "AWS::IAM::Role",
   "Properties": {
    "AssumeRolePolicyDocument": {
     "Statement": [
      {
       "Action": "sts:AssumeRole",
       "Effect": "Allow",
       "Principal": {
        "AWS": {
         "Fn::Join": [
          "",
          [
           "arn:",
           {
            "Ref": "AWS::Partition"
           },
           ":iam::",
           {
            "Ref": "ApiableTrustAccount"
           },
           ":root"
          ]
         ]
        }
       }
      }
     ],
     "Version": "2012-10-17"
    },
    "Description": "Role for Apiable to manage the API Gateway",
    "RoleName": {
     "Fn::Join": [
      "",
      [
       "apiable-gateway-management-role-",
       {
        "Ref": "AWS::Region"
       }
      ]
     ]
    },
    "Tags": [
     {
      "Key": "apiable:logical-id",
      "Value": "apiable-gateway-role"
     }
    ]
   },
   "Metadata": {
    "aws:cdk:path": "apiable-gateway-role/GatewayRole/GatewayManagementRole/Resource"
   }
  },
  "GatewayRoleGatewayManagementRoleDefaultPolicy472C1A67": {
   "Type": "AWS::IAM::Policy",
   "Properties": {
    "PolicyDocument": {
     "Statement": [
      {
       "Action": "apigateway:GET",
       "Effect": "Allow",
       "Resource": [
        {
         "Fn::Join": [
          "",
          [
           "arn:aws:apigateway:",
           {
            "Ref": "AWS::Region"
           },
           "::/restapis"
          ]
         ]
        },
        {
         "Fn::Join": [
          "",
          [
           "arn:aws:apigateway:",
           {
            "Ref": "AWS::Region"
           },
           "::/restapis/*"
          ]
         ]
        }
       ],
       "Sid": "ReadRestApisOnly"
      },
      {
       "Action": [
        "apigateway:DELETE",
        "apigateway:GET",
        "apigateway:PATCH",
        "apigateway:POST"
       ],
       "Effect": "Allow",
       "Resource": [
        {
         "Fn::Join": [
          "",
          [
           "arn:aws:apigateway:",
           {
            "Ref": "AWS::Region"
           },
           "::/apikeys"
          ]
         ]
        },
        {
         "Fn::Join": [
          "",
          [
           "arn:aws:apigateway:",
           {
            "Ref": "AWS::Region"
           },
           "::/apikeys/*"
          ]
         ]
        },
        {
         "Fn::Join": [
          "",
          [
           "arn:aws:apigateway:",
           {
            "Ref": "AWS::Region"
           },
           "::/usageplans"
          ]
         ]
        },
        {
         "Fn::Join": [
          "",
          [
           "arn:aws:apigateway:",
           {
            "Ref": "AWS::Region"
           },
           "::/usageplans/*"
          ]
         ]
        }
       ],
       "Sid": "ManageApiKeysAndUsagePlans"
      },
      {
       "Action": "apigateway:PUT",
       "Effect": "Allow",
       "Resource": {
        "Fn::Join": [
         "",
         [
          "arn:aws:apigateway:",
          {
           "Ref": "AWS::Region"
          },
          "::/tags/*"
         ]
        ]
       },
       "Sid": "TagUsagePlans"
      },
      {
       "Action": "apigateway:*",
       "Effect": "Deny",
       "Resource": [
        {
         "Fn::Join": [
          "",
          [
           "arn:aws:apigateway:",
           {
            "Ref": "AWS::Region"
           },
           "::/apis"
          ]
         ]
        },
        {
         "Fn::Join": [
          "",
          [
           "arn:aws:apigateway:",
           {
            "Ref": "AWS::Region"
           },
           "::/apis/*"
          ]
         ]
        }
       ],
       "Sid": "DenyHttpAndWebSocketApis"
      },
      {
       "Action": "apigateway:*",
       "Condition": {
        "NotIpAddress": {
         "aws:SourceIp": {
          "Ref": "ApiableEgressCidr"
         }
        }
       },
       "Effect": "Deny",
       "Resource": "*",
       "Sid": "DenyOutsideApiableEgress"
      }
     ],
     "Version": "2012-10-17"
    },
    "PolicyName": "GatewayRoleGatewayManagementRoleDefaultPolicy472C1A67",
    "Roles": [
     {
      "Ref": "GatewayRoleGatewayManagementRoleACBD3808"
     }
    ]
   },
   "Metadata": {
    "aws:cdk:path": "apiable-gateway-role/GatewayRole/GatewayManagementRole/DefaultPolicy/Resource"
   }
  }
 },
 "Outputs": {
  "GatewayRoleGatewayManagementRoleArnF0F4FA8B": {
   "Value": {
    "Fn::GetAtt": [
     "GatewayRoleGatewayManagementRoleACBD3808",
     "Arn"
    ]
   }
  }
 }
}