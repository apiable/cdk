{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "baseUrl": ".",
    "paths": {
      "@apiable/cdk-gateway-role": ["lib/gateway-role/index.ts"],
      "@apiable/cdk-logs-bucket": ["lib/logs-bucket/index.ts"],
      "@apiable/parity-gate": ["lib/parity-gate/index.ts"],
      "@apiable/umbrella": ["lib/umbrella/index.ts"],
      "@apiable/cdk-ssm-composition": ["lib/ssm-composition/index.ts"],
      "@apiable/cdk-console-explainer": ["lib/console-explainer/index.ts"]
    },
    "lib": [
      "es2020",
      "dom"
    ],
    "declaration": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": false,
    "inlineSourceMap": true,
    "inlineSources": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "typeRoots": [
      "./node_modules/@types"
    ]
  },
  "exclude": [
    "node_modules",
    "cdk.out"
  ]
}
